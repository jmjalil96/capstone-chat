# Non-secret production host contract. Replace every __PLACEHOLDER__ during the
# reviewed host installation; verification fails while any placeholder remains.
CAPSTONE_PUBLIC_HOST=chat.capstone.com.ec
CAPSTONE_PUBLIC_ORIGIN=https://chat.capstone.com.ec
CAPSTONE_NODE_ENV=production
CAPSTONE_CLIENT_ADDRESS_SOURCE=caddy
CAPSTONE_EMAIL_DELIVERY=resend
CAPSTONE_EMAIL_FROM="Capstone Chat <no-reply@mail.capstone.com.ec>"
CAPSTONE_MODEL_GATEWAY=openrouter
CAPSTONE_OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.nr-data.net
CAPSTONE_EXPECTED_OUTBOUND_IPV4=__DIGITALOCEAN_RESERVED_IPV4__
CAPSTONE_OPERATOR_IPV4_CIDR=__OPERATOR_IPV4_CIDR__
CAPSTONE_EXPECTED_REGION=ric1
CAPSTONE_EXPECTED_VOLUME_BYTES=1073741824
CAPSTONE_IMAGE_REPOSITORY=ghcr.io/__GITHUB_OWNER__/capstone-chat
CAPSTONE_GITHUB_PACKAGE_API_SCOPE=users
CAPSTONE_EXPECTED_DOCKER_VERSION=__DOCKER_ENGINE_VERSION__
CAPSTONE_EXPECTED_CADDY_VERSION=__CADDY_VERSION__
CAPSTONE_EXPECTED_FLUENT_BIT_VERSION=__FLUENT_BIT_VERSION__

CAPSTONE_SECURE_ROOT=/srv/capstone-secure
CAPSTONE_RUNTIME_SECRET_PATH=/srv/capstone-secure/runtime/runtime.json
CAPSTONE_MIGRATION_SECRET_PATH=/srv/capstone-secure/migration/migration.json
CAPSTONE_REGISTRY_CONFIG_DIR=/srv/capstone-secure/registry
CAPSTONE_CADDY_STATE_DIR=/srv/capstone-secure/caddy
CAPSTONE_FLUENT_BIT_ENV_PATH=/srv/capstone-secure/fluent-bit/new-relic.env

CAPSTONE_RUNTIME_SECRET_GID=21001
CAPSTONE_MIGRATION_SECRET_GID=21002
CAPSTONE_CADDY_SECRET_GID=21003
CAPSTONE_FLUENT_BIT_SECRET_GID=21004
