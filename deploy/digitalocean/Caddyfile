{
	admin unix//run/capstone-caddy/admin.sock
	persist_config off
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

http://{$CAPSTONE_PUBLIC_HOST} {
	redir https://{$CAPSTONE_PUBLIC_HOST}{uri} 308
}

https://{$CAPSTONE_PUBLIC_HOST} {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}

	route {
		import /run/capstone-caddy/upstream.caddy
	}
}
