[Unit]
Description=Capstone Chat application slot %i
Documentation=file:/opt/capstone-chat/README.md
After=docker.service capstone-fluent-bit.service network-online.target
Wants=network-online.target capstone-fluent-bit.service
Requires=docker.service
RequiresMountsFor=/srv/capstone-secure/runtime
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/run/capstone-chat/slot-%i.env
ExecStart=/usr/bin/docker run --name capstone-chat-%i --network host --user 1000:1000 --group-add 21001 --read-only --tmpfs /tmp:rw,noexec,nosuid,nodev,size=32m,mode=1777 --cap-drop ALL --security-opt no-new-privileges=true --pids-limit 256 --memory 640m --memory-swap 640m --ulimit core=0:0 --restart no --mount type=bind,src=/srv/capstone-secure/runtime/runtime.json,dst=/run/capstone-secrets/runtime.json,readonly --env CAPSTONE_SECRET_FILE=/run/capstone-secrets/runtime.json --env NODE_ENV=${CAPSTONE_NODE_ENV} --env HOST=127.0.0.1 --env PORT=${CAPSTONE_PORT} --env PUBLIC_ORIGIN=${CAPSTONE_PUBLIC_ORIGIN} --env CLIENT_ADDRESS_SOURCE=${CAPSTONE_CLIENT_ADDRESS_SOURCE} --env EMAIL_DELIVERY=${CAPSTONE_EMAIL_DELIVERY} --env EMAIL_FROM=${CAPSTONE_EMAIL_FROM} --env MODEL_GATEWAY=${CAPSTONE_MODEL_GATEWAY} --env WEB_ASSETS=production-build --env OTEL_EXPORTER_OTLP_ENDPOINT=${CAPSTONE_OTEL_EXPORTER_OTLP_ENDPOINT} --env LOG_LEVEL=info --env DEPLOYMENT_REVISION=${CAPSTONE_REVISION} --label io.capstone.slot=%i --label io.capstone.revision=${CAPSTONE_REVISION} --label io.capstone.digest=${CAPSTONE_DIGEST} --log-driver fluentd --log-opt fluentd-address=unix:///run/capstone-fluent-bit/docker.sock --log-opt fluentd-async=true --log-opt fluentd-buffer-limit=1024 --log-opt fluentd-retry-wait=1s --log-opt fluentd-max-retries=10 --log-opt fluentd-write-timeout=1s --log-opt mode=non-blocking --log-opt max-buffer-size=4m --log-opt cache-disabled=true --log-opt tag=capstone.api ${CAPSTONE_IMAGE}
ExecStop=/usr/bin/docker stop --time 300 capstone-chat-%i
TimeoutStartSec=60s
TimeoutStopSec=330s
KillMode=process
Restart=no
LimitCORE=0
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/etc/capstone-chat /srv/capstone-secure/runtime
ReadWritePaths=/run/capstone-chat
RemoveIPC=true
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
