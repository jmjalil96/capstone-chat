[Unit]
Description=Supervised Capstone administrative or recovery command
Documentation=file:/opt/capstone-chat/README.md
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
RequiresMountsFor=/srv/capstone-secure

[Service]
Type=oneshot
User=root
Group=root
Environment=CAPSTONE_OPERATOR_SUPERVISED=1
RuntimeDirectory=capstone-operator
RuntimeDirectoryMode=0700
UMask=0077
ExecStart=/opt/capstone-chat/bin/operator.sh
ExecStopPost=/opt/capstone-chat/bin/operator.sh cleanup-runtime
ExecStopPost=/usr/bin/timeout --signal=TERM --kill-after=10s 60s /opt/capstone-chat/bin/cleanup-migrations.sh post-stop
ExecStopPost=-/usr/bin/timeout --signal=TERM --kill-after=10s 30s /usr/bin/docker rm --force capstone-operator
# Initial path: pull/inspection (255s) + migration lifecycle (485s) +
# operator command/removal (610s) + post-stop cleanup (60s) + 390s headroom.
TimeoutStartSec=1800s
TimeoutStopSec=210s
KillMode=mixed
LimitCORE=0
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/etc/capstone-chat /opt/capstone-chat /srv/capstone-secure
ReadWritePaths=/run/capstone-operator /var/lib/capstone-chat
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
