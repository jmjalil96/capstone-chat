[Unit]
Description=Capstone bounded application log forwarder
Documentation=file:/opt/capstone-chat/README.md
After=network-online.target srv-capstone\x2dsecure.mount
Wants=network-online.target
RequiresMountsFor=/srv/capstone-secure/fluent-bit
Before=docker.service capstone-boot.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=capstone-fluent-bit
Group=capstone-fluent-bit-secrets
RuntimeDirectory=capstone-fluent-bit
RuntimeDirectoryMode=0750
UMask=0027
ExecStart=/opt/capstone-chat/bin/start-fluent-bit.sh
TimeoutStartSec=30s
TimeoutStopSec=15s
Restart=on-failure
RestartSec=5s
LimitCORE=0
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ReadOnlyPaths=/etc/capstone-chat /opt/fluent-bit /srv/capstone-secure/fluent-bit
ReadWritePaths=/run/capstone-fluent-bit
RemoveIPC=true
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
