[Unit]
Description=Supervised Capstone deploy, rollback, or maintenance transition
Documentation=file:/opt/capstone-chat/README.md
After=docker.service capstone-caddy.service capstone-fluent-bit.service network-online.target
Requires=docker.service capstone-caddy.service
Wants=capstone-fluent-bit.service network-online.target
RequiresMountsFor=/srv/capstone-secure
OnFailure=capstone-boot.service

[Service]
Type=oneshot
User=root
Group=root
Environment=CAPSTONE_DEPLOY_SUPERVISED=1
Environment=XDG_DATA_HOME=/srv/capstone-secure/caddy/data
Environment=XDG_CONFIG_HOME=/srv/capstone-secure/caddy/config
ExecStart=/opt/capstone-chat/bin/deploy.sh request
ExecStopPost=/usr/bin/timeout --signal=TERM --kill-after=10s 60s /opt/capstone-chat/bin/cleanup-migrations.sh post-stop
# Worst case: initial reconciliation (575s) + pull (210s) + migration path
# (485s) + candidate/public activation (245s) + old stop (330s) + final
# verification (155s) + 400s host/daemon headroom.
TimeoutStartSec=2400s
# TERM child forwarding (30s) + fail-safe convergence (790s) + migration
# post-stop cleanup (60s) + 320s scheduler/daemon headroom.
TimeoutStopSec=1200s
KillMode=mixed
LimitCORE=0
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/etc/capstone-chat /opt/capstone-chat /srv/capstone-secure
ReadWritePaths=/run/capstone-caddy /run/capstone-chat /run/capstone-deploy /var/lib/capstone-chat
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
