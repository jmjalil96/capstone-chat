[Unit]
Description=Capstone public TLS boundary
Documentation=file:/opt/capstone-chat/README.md
After=network-online.target srv-capstone\x2dsecure.mount
Wants=network-online.target
RequiresMountsFor=/srv/capstone-secure/caddy
Before=capstone-boot.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=notify
User=caddy
Group=capstone-caddy-secrets
EnvironmentFile=/etc/capstone-chat/host.env
Environment=CAPSTONE_DEPLOY_SUPERVISED=1
Environment=XDG_DATA_HOME=/srv/capstone-secure/caddy/data
Environment=XDG_CONFIG_HOME=/srv/capstone-secure/caddy/config
RuntimeDirectory=capstone-caddy
RuntimeDirectoryMode=0750
UMask=0027
ExecStartPre=+/opt/capstone-chat/bin/deploy.sh prepare-caddy
ExecStartPre=/usr/bin/caddy validate --config /etc/capstone-chat/Caddyfile --adapter caddyfile
ExecStart=/usr/bin/caddy run --config /etc/capstone-chat/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /etc/capstone-chat/Caddyfile --adapter caddyfile --address unix//run/capstone-caddy/admin.sock --force
TimeoutStartSec=120s
TimeoutStopSec=30s
Restart=on-failure
RestartSec=5s
LimitCORE=0
LimitNOFILE=1048576
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
InaccessiblePaths=/srv/capstone-secure/runtime /srv/capstone-secure/migration /srv/capstone-secure/registry /srv/capstone-secure/fluent-bit
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ReadOnlyPaths=/etc/capstone-chat
ReadWritePaths=/run/capstone-caddy /run/capstone-chat /srv/capstone-secure/caddy /var/lib/capstone-chat
RemoveIPC=true
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
