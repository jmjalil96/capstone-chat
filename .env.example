# Optional low-level development overrides. Hosted configuration lives in deploy/app-platform/.
# Managed `pnpm dev` constructs DATABASE_URL, PUBLIC_ORIGIN, and the fake gateway/email boundary.
NODE_ENV=development
CAPSTONE_ENVIRONMENT=development
DATABASE_URL=postgresql://capstone:capstone@127.0.0.1:5432/capstone_chat
PUBLIC_ORIGIN=http://127.0.0.1:5173
BETTER_AUTH_SECRET=capstone-chat-local-auth-secret-not-for-production-use
EMAIL_DELIVERY=fake
MODEL_GATEWAY=fake
# A dedicated key is required only for the explicit development OpenRouter opt-in.
OPENROUTER_API_KEY=
LOG_LEVEL=info
# Leave application ports blank to select the first available managed port.
CAPSTONE_API_PORT=
CAPSTONE_WEB_PORT=
CAPSTONE_DEV_ADMIN_EMAIL=admin@example.test
CAPSTONE_POSTGRES_PORT=5432
