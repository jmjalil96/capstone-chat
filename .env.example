NODE_ENV=development
# Production App Platform uses digitalocean-app-platform and platform-environment.
DEPLOYMENT_TARGET=
CAPSTONE_SECRET_SOURCE=
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://capstone:capstone@127.0.0.1:5432/capstone_chat
PUBLIC_ORIGIN=http://localhost:5173
BETTER_AUTH_SECRET=capstone-chat-local-auth-secret-not-for-production-use
EMAIL_DELIVERY=fake
# Production requires EMAIL_DELIVERY=resend and the approved verified sender.
RESEND_API_KEY=
EMAIL_FROM=
LOG_LEVEL=info
MODEL_GATEWAY=openrouter
# pnpm dev requires a dedicated live-development key.
OPENROUTER_API_KEY=
DEPLOYMENT_REVISION=development
CLIENT_ADDRESS_SOURCE=socket
# CAPSTONE_SECRET_FILE is reserved for the isolated offline-recovery command, never the service.
CAPSTONE_SECRET_FILE=
# The temporary production first-provisioning job alone receives these values and schema version 2.
CAPSTONE_INITIALIZATION_SCHEMA_VERSION=
CAPSTONE_BOOTSTRAP_MIGRATION_DATABASE_URL=
CAPSTONE_BOOTSTRAP_DATABASE_URL=
CAPSTONE_INITIALIZATION_DOCUMENT=
# Production requires the New Relic regional HTTPS OTLP origin and one api-key header.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
CAPSTONE_WEB_PORT=5173
CAPSTONE_POSTGRES_PORT=5432
