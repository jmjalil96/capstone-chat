{
  "name": "@capstone/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "auth:schema:generate": "auth generate --config src/auth/schema-generation.ts --output src/database/auth-schema.generated.ts --adapter drizzle --dialect postgresql --yes && biome check --write src/database/auth-schema.generated.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "biome check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate-command.ts",
    "dev": "tsx watch src/server.ts",
    "identity:approve": "tsx src/operator/identity-command.ts approve",
    "identity:bootstrap": "tsx src/operator/identity-command.ts bootstrap",
    "identity:deactivate": "tsx src/operator/identity-command.ts deactivate",
    "migrate:production": "node dist/database/migrate-command.js",
    "model-catalog:refresh": "tsx src/operator/model-policy-command.ts refresh",
    "model-policy:attest": "tsx src/operator/model-policy-command.ts attest",
    "model-policy:bootstrap": "tsx src/operator/model-policy-command.ts bootstrap",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.26",
    "@capstone/protocol": "workspace:*",
    "@fastify/type-provider-typebox": "6.1.0",
    "better-auth": "1.6.26",
    "decimal.js": "10.6.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "eventsource-parser": "3.1.0",
    "fastify": "5.11.2",
    "pg": "8.22.0",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.4",
    "auth": "1.6.26",
    "drizzle-kit": "0.31.10",
    "testcontainers": "12.1.0",
    "tsx": "4.23.9",
    "vitest": "4.1.10"
  }
}
