{
  "name": "@capstone/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "biome check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate-command.ts",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/database/migrate-command.ts",
    "migrate:production": "node dist/database/migrate-command.js",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@capstone/protocol": "workspace:*",
    "@fastify/type-provider-typebox": "6.1.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.11.2",
    "pg": "8.22.0",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.4",
    "drizzle-kit": "0.31.10",
    "testcontainers": "12.1.0",
    "tsx": "4.23.9",
    "vitest": "4.1.10"
  }
}
