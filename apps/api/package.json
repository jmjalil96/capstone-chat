{
  "name": "@capstone/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "auth:schema:generate": "auth generate --config src/auth/schema-generation.ts --output src/database/auth-schema.generated.ts --adapter drizzle --dialect postgresql --yes && biome check --write src/database/auth-schema.generated.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "biome check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/entrypoint.ts migrate",
    "dev": "tsx watch src/entrypoint.ts server",
    "identity:approve": "tsx src/entrypoint.ts identity approve",
    "identity:bootstrap": "tsx src/entrypoint.ts identity bootstrap",
    "identity:deactivate": "tsx src/entrypoint.ts identity deactivate",
    "identity:invite-initial": "tsx src/entrypoint.ts invite-initial",
    "load:test": "tsx tests/load-harness.ts",
    "load:server": "node --expose-gc --import tsx src/entrypoint.ts load-server --confirm-isolated-load-rehearsal",
    "migrate:production": "node dist/entrypoint.js migrate",
    "model-catalog:refresh": "tsx src/entrypoint.ts model refresh",
    "model-policy:attest": "tsx src/entrypoint.ts model attest",
    "model-policy:bootstrap": "tsx src/entrypoint.ts model bootstrap",
    "production:initialize": "tsx src/entrypoint.ts initialize",
    "production:initialize:container": "node dist/entrypoint.js initialize",
    "recovery-marker": "tsx src/entrypoint.ts recovery-marker",
    "recovery:prepare": "tsx src/entrypoint.ts recovery-prepare",
    "recovery:prepare:production": "node dist/entrypoint.js recovery-prepare",
    "start": "node dist/entrypoint.js server",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.26",
    "@capstone/protocol": "workspace:*",
    "@fastify/static": "10.1.3",
    "@fastify/type-provider-typebox": "6.1.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "better-auth": "1.6.26",
    "decimal.js": "10.6.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "eventsource-parser": "3.1.0",
    "fastify": "5.11.2",
    "pg": "8.22.0",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.4",
    "auth": "1.6.26",
    "drizzle-kit": "0.31.10",
    "testcontainers": "12.1.0",
    "tsx": "4.23.9",
    "typebox": "1.3.11",
    "vitest": "4.1.10"
  }
}
