{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "brand": {
      "navy": { "$value": "#0C2939", "$type": "color" },
      "navyLift": { "$value": "#123449", "$type": "color" },
      "gold": { "$value": "#E2AB33", "$type": "color" },
      "teal": { "$value": "#008C7E", "$type": "color" },
      "tealInk": { "$value": "#007265", "$type": "color" },
      "mint": { "$value": "#7FD1C5", "$type": "color" },
      "white": { "$value": "#FFFFFF", "$type": "color" },
      "paper": { "$value": "#F2F6F5", "$type": "color" },
      "warmWhite": { "$value": "#F7F7F4", "$type": "color" },
      "border": { "$value": "#D9DFE1", "$type": "color" },
      "slate": { "$value": "#44565F", "$type": "color" },
      "muted": { "$value": "#5B6B74", "$type": "color" },
      "danger": { "$value": "#B4232A", "$type": "color" }
    },
    "semantic": {
      "surface": { "$value": "{color.brand.white}", "$type": "color" },
      "surfaceSoft": { "$value": "{color.brand.paper}", "$type": "color" },
      "ink": { "$value": "{color.brand.navy}", "$type": "color" },
      "inkMuted": { "$value": "{color.brand.muted}", "$type": "color" },
      "decisive": { "$value": "{color.brand.gold}", "$type": "color" },
      "guidance": { "$value": "{color.brand.tealInk}", "$type": "color" },
      "rule": { "$value": "{color.brand.border}", "$type": "color" }
    }
  },
  "font": {
    "family": {
      "display": { "$value": "Bricolage Grotesque", "$type": "fontFamily" },
      "body": { "$value": "Figtree", "$type": "fontFamily" },
      "data": { "$value": "IBM Plex Mono", "$type": "fontFamily" }
    },
    "weight": {
      "regular": { "$value": 400, "$type": "fontWeight" },
      "medium": { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold": { "$value": 700, "$type": "fontWeight" },
      "extrabold": { "$value": 800, "$type": "fontWeight" }
    }
  },
  "radius": {
    "xs": { "$value": "4px", "$type": "dimension" },
    "sm": { "$value": "6px", "$type": "dimension" },
    "md": { "$value": "10px", "$type": "dimension" }
  },
  "motion": {
    "fast": { "$value": "150ms", "$type": "duration" },
    "standard": { "$value": "240ms", "$type": "duration" },
    "reveal": { "$value": "520ms", "$type": "duration" },
    "easeStandard": { "$value": [0.2, 0.8, 0.2, 1], "$type": "cubicBezier" }
  }
}

